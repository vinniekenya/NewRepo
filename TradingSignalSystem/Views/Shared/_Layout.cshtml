<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trading AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" />
</head>
<body>
    <!-- 🔥 NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-danger shadow fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Dashboard" asp-action="Index">
                    <img src="~/images/botlogo.png" alt="logo" style="height:40px; margin-right:10px;" />
                    <span class="fw-bold">Trading AI</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                                📊 Dashboard
                            </a>
                        </li>

                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/Admin/Index">
                                    👑 Admin Panel
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("UserRole") == "VIP")
                        {
                            <li class="nav-item">
                                <span class="nav-link text-warning fw-bold">⭐ VIP</span>
                            </li>
                        }

                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserEmail")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/Account/Logout">
                                    🚪 Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/Account/Login">
                                    🔑 Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ✅ Push content below fixed navbar -->
    <div style="margin-top: 70px;">
        <div class="container mt-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- 🔥 FOOTER -->
    <footer class="text-center text-light mt-5 mb-3">
        <div>&copy; 2026 - Trading AI System 🚀</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>